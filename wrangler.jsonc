{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker URL: https://glance.<your-workers-subdomain>.workers.dev
  // Confirm the selected account with `npx wrangler whoami` before deploying.
  "name": "glance",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "glance"
    }
  ],
  "vars": {
    "AI_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
