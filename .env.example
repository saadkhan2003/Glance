# The complete demo works without a key. AI requests require explicit opt-in.
AI_ENABLED=false
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Set this to the exact public HTTPS origin when deploying behind a proxy.
APP_ORIGIN=http://localhost:3000
# Durable request ceiling for a single Node process. Failed requests also count.
AI_DAILY_REQUEST_LIMIT=100
# Docker mounts this path on a named volume. Omit locally to use .data/ai-budget.
# AI_BUDGET_DIR=/app/.data/ai-budget
